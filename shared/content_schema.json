{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://10min-ai-daily.dev/schemas/content_item.v1.json",
  "title": "ContentItem",
  "description": "Canonical content contract across ingestion, preprocessing, cards, briefing, and graph.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "description": "Stable unique id (UUID preferred).",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "enum": [
        "github",
        "huggingface",
        "arxiv_cs_ai",
        "arxiv_cs_lg",
        "arxiv_cs_cl",
        "openai_blog",
        "anthropic_blog",
        "deepmind_blog",
        "other"
      ]
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "raw_summary": {
      "type": "string"
    },
    "raw_content": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "description": "Source-specific metadata (stars, language, authors, likes, etc.).",
      "additionalProperties": true
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "pipeline_state": {
      "type": "string",
      "enum": [
        "raw_scraped",
        "keywords_enriched",
        "preprocessed",
        "card_ready"
      ]
    },
    "preprocessing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cleaned_text": {
          "type": "string"
        },
        "quality_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "quality_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enrichment_used": {
          "type": "boolean"
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "card_title": {
          "type": "string",
          "minLength": 1
        },
        "card_summary": {
          "type": "string",
          "maxLength": 120
        },
        "keywords": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "thumbnail_keyword": {
          "type": "string"
        }
      },
      "required": [
        "card_title",
        "card_summary",
        "keywords"
      ]
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_rank_score": {
          "type": "number",
          "minimum": 0
        },
        "trending_score": {
          "type": "number",
          "minimum": 0
        },
        "recommendation_score": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collector": {
          "type": "string"
        },
        "collector_version": {
          "type": "string"
        },
        "normalizer_version": {
          "type": "string"
        },
        "dedupe_key": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "source",
    "source_url",
    "title",
    "raw_content",
    "metadata",
    "fetched_at"
  ]
}
